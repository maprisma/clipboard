#!/usr/bin/env python3
"""Bundle checked-in 8-language translation catalogs into translations/bundled.json."""
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
base = root / "translations"
catalogs = {}
for code in ("en", "de", "fr", "es", "it", "pt", "nl", "pl"):
    catalogs[code] = json.loads((base / f"{code}.json").read_text(encoding="utf-8"))
(base / "bundled.json").write_text(
    json.dumps(catalogs, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
)
